async function loadMembers(container){
  if(!container) return;

  container.innerHTML = `<div class="members-state"><div><span class="loader"></span>Loading secretariat...</div></div>`;

  try{
    const {data,error} = await supabase
      .from("members")
      .select(`id,name,role_title,committee,photo_index,photo_url,sort_order`)
      .order("sort_order",{ascending:true});

    if(error) throw error;

    if(!data?.length){
      container.innerHTML = `<div class="members-state">No secretariat members have been published yet.</div>`;
      return;
    }

    container.innerHTML = `
      <div class="member-grid">
        ${data.map(member=>{
          const imageSource = member.photo_url || (member.photo_index ? `./member${Number(member.photo_index)}.png` : "");
          return `
            <article class="member reveal">
              <div class="member-photo">
                <div class="member-fallback">${escapeHtml(initials(member.name))}</div>
                ${imageSource ? `<img src="${escapeHtml(imageSource)}" alt="${escapeHtml(member.name)}" loading="lazy" onerror="this.style.display='none'">` : ""}
              </div>
              <div class="member-body">
                <div class="member-name">${escapeHtml(member.name)}</div>
                <div class="member-role">${escapeHtml(member.role_title || "Secretariat")}</div>
                ${member.committee ? `<div class="member-committee">${escapeHtml(member.committee)}</div>` : ""}
              </div>
            </article>
          `;
        }).join("")}
      </div>
    `;

    observeReveals();
  }catch(error){
    console.error("Member loading error:",error);
    container.innerHTML = `<div class="members-state">The secretariat roster is temporarily unavailable.</div>`;
  }
}

function renderRegister(){
  renderPage(`
    <section class="auth-screen">
      <div class="container">
        <div class="auth-card" style="width:min(100%,640px)">
          <span class="eyebrow">Session XV</span>
          <h1 class="auth-title">Register.</h1>
          <p class="auth-sub">Submit your delegate registration for PaceMUN — Saturday, October 31, 2026.</p>

          <form class="auth-form" id="registerForm">
            <div class="field">
              <label for="regName">Full name</label>
              <input id="regName" type="text" required placeholder="Enter your full name">
            </div>
            <div class="field">
              <label for="regSchool">School / University</label>
              <input id="regSchool" type="text" required placeholder="Your school name">
            </div>
            <div class="field">
              <label for="regEmail">Email address</label>
              <input id="regEmail" type="email" required placeholder="you@example.com" autocomplete="email">
            </div>
            <div class="field">
              <label for="regPhone">Contact number</label>
              <input id="regPhone" type="tel" required placeholder="+971 5X XXX XXXX" pattern="^\+?[0-9\s-]{7,15}$" autocomplete="tel">
            </div>
            <div class="field">
              <label for="regCommittee">Preferred committee</label>
              <select id="regCommittee" required>
                <option value="">Select a committee</option>
                <option>WHO (Beginner 6-8)</option>
                <option>UNHRC (Intermediate)</option>
                <option>UNODC (Intermediate)</option>
                <option>UNCTAD (Advanced)</option>
                <option>INTERPOL (Advanced)</option>
                <option>DISEC (Beginner)</option>
              </select>
            </div>
            <div class="field">
              <label for="regExperience">MUN experience</label>
              <textarea id="regExperience" placeholder="Briefly describe your MUN experience"></textarea>
            </div>

            <button class="btn btn-primary auth-submit" id="registerSubmit" type="submit">Submit registration</button>
          </form>

          <div class="auth-message" id="registerMessage"></div>
        </div>
      </div>
    </section>
  `);

  const form = $("#registerForm");
  const submit = $("#registerSubmit");
  const message = $("#registerMessage");

  form.addEventListener("submit",async event=>{
    event.preventDefault();

    if(!form.checkValidity()){
      form.reportValidity();
      return;
    }

    submit.disabled = true;
    submit.textContent = "Submitting...";

    try{
      const payload = {
        full_name:$("#regName").value.trim(),
        school:$("#regSchool").value.trim(),
        email:$("#regEmail").value.trim(),
        phone:$("#regPhone").value.trim(),
        preferred_committee:$("#regCommittee").value,
        experience:$("#regExperience").value.trim()
      };

      const {error} = await supabase.from("registrations").insert(payload);

      if(error) throw error;

      setMessage(message,"Registration submitted successfully. We will contact you with next steps.","ok");
      form.reset();
    }catch(error){
      console.error(error);
      setMessage(message,error?.message || "Unable to submit registration. Please try again.","error");
    }finally{
      submit.disabled = false;
      submit.textContent = "Submit registration";
    }
  });
}

function renderLogin(){
  renderPage(`
    <section class="auth-screen">
      <div class="container">
        <div class="auth-card">
          <span class="eyebrow" id="authMode">Delegate portal</span>
          <h1 class="auth-title" id="authTitle">Sign in.</h1>
          <p class="auth-sub" id="authSub">Use the email and password associated with your conference account.</p>

          <form class="auth-form" id="authForm">
            <div class="field hidden" id="nameField">
              <label for="fullName">Full name</label>
              <input id="fullName" type="text" autocomplete="name" placeholder="Your full name">
            </div>
            <div class="field">
              <label for="email">Email address</label>
              <input id="email" type="email" autocomplete="email" placeholder="you@school.edu" required>
            </div>
            <div class="field">
              <label for="password">Password</label>
              <input id="password" type="password" autocomplete="current-password" placeholder="••••••••" minlength="6" required>
            </div>
            <button class="btn btn-primary auth-submit" id="authSubmit" type="submit">Sign in</button>
          </form>

          <div class="auth-message" id="authMessage"></div>

          <div class="auth-switch">
            <span id="switchLabel">New delegate?</span>
            <button type="button" id="switchButton">Create an account</button>
          </div>
        </div>
      </div>
    </section>
  `);

  let mode = "signin";

  const form = $("#authForm");
  const nameField = $("#nameField");
  const fullName = $("#fullName");
  const email = $("#email");
  const password = $("#password");
  const submit = $("#authSubmit");
  const message = $("#authMessage");
  const authMode = $("#authMode");
  const authTitle = $("#authTitle");
  const authSub = $("#authSub");
  const switchLabel = $("#switchLabel");
  const switchButton = $("#switchButton");

  function updateMode(){
    const signup = mode === "signup";
    nameField.classList.toggle("hidden",!signup);
    fullName.required = signup;
    authMode.textContent = signup ? "Create account" : "Delegate portal";
    authTitle.textContent = signup ? "Join PACE." : "Sign in.";
    authSub.textContent = signup
      ? "Create your conference account using the email you will use for PACE."
      : "Use the email and password associated with your conference account.";
    submit.textContent = signup ? "Create account" : "Sign in";
    switchLabel.textContent = signup ? "Already registered?" : "New delegate?";
    switchButton.textContent = signup ? "Sign in instead" : "Create an account";
    message.className = "auth-message";
  }

  switchButton.addEventListener("click",()=>{
    mode = mode === "signin" ? "signup" : "signin";
    updateMode();
  });

  form.addEventListener("submit",async event=>{
    event.preventDefault();
    message.className = "auth-message";
    submit.disabled = true;
    submit.innerHTML = `<span class="loader"></span>${mode === "signup" ? "Creating..." : "Signing in..."}`;

    try{
      const userEmail = email.value.trim();
      const userPassword = password.value;
      const userName = fullName.value.trim();

      const endpoint = mode === "signup"
        ? `${SUPABASE_URL}/auth/v1/signup`
        : `${SUPABASE_URL}/auth/v1/token?grant_type=password`;

      const requestBody = mode === "signup"
        ? { email:userEmail, password:userPassword, data:{ full_name:userName } }
        : { email:userEmail, password:userPassword };

      const response = await fetch(endpoint,{
        method:"POST",
        headers:{ "Content-Type":"application/json","apikey":SUPABASE_KEY },
        body:JSON.stringify(requestBody)
      });

      let result = null;
      try{ result = await response.json(); }catch{ result = null; }

      if(!response.ok){
        const errorMessage = result?.msg || result?.message || result?.error_description || result?.error || `Authentication failed (${response.status})`;
        throw new Error(errorMessage);
      }

      if(mode === "signin" && result?.access_token && result?.refresh_token){
        const {error} = await supabase.auth.setSession({ access_token:result.access_token, refresh_token:result.refresh_token });
        if(error) throw error;

        state.session = (await supabase.auth.getSession()).data.session;
        state.profile = state.session ? await loadProfile(state.session.user.id) : null;

        location.hash = state.profile?.role === "admin" ? "#/admin" : "#/dashboard";
        return;
      }

      if(mode === "signup" && !result?.access_token){
        setMessage(message,"Account created. Check your email if confirmation is enabled, then sign in.","ok");
        return;
      }

      if(mode === "signup" && result?.access_token && result?.refresh_token){
        const {error} = await supabase.auth.setSession({ access_token:result.access_token, refresh_token:result.refresh_token });
        if(error) throw error;

        state.session = (await supabase.auth.getSession()).data.session;
        state.profile = state.session ? await loadProfile(state.session.user.id) : null;

        location.hash = state.profile?.role === "admin" ? "#/admin" : "#/dashboard";
      }
    }catch(error){
      console.error("Authentication error:",error);
      setMessage(message,error?.message || "Unable to complete authentication.","error");
    }finally{
      submit.disabled = false;
      submit.textContent = mode === "signup" ? "Create account" : "Sign in";
    }
  });
}

async function loadProfile(userId){
  const {data,error} = await supabase.from("profiles").select("*").eq("id",userId).single();
  if(error){
    console.warn("Profile could not be loaded:",error);
    return null;
  }
  return data;
}

