async function renderAdmin(){
  if(state.profile?.role !== "admin"){
    location.hash = "#/dashboard";
    return;
  }

  renderPage(`
    <section class="admin">
      <div class="container">
        <div class="dashboard-head">
          <div>
            <span class="eyebrow">Management control</span>
            <h1>Administration.</h1>
            <div class="dashboard-sub">Manage the public secretariat roster.</div>
          </div>
          <span class="badge">Admin</span>
        </div>

        <div class="admin-grid">
          <section class="admin-panel reveal">
            <h3 id="formTitle">Add a secretariat member</h3>

            <form class="admin-form" id="memberForm">
              <input id="memberId" type="hidden">

              <div class="field">
                <label for="memberName">Name</label>
                <input id="memberName" type="text" required placeholder="Full name">
              </div>

              <div class="field">
                <label for="memberRole">Role title</label>
                <input id="memberRole" type="text" required placeholder="Secretary-General">
              </div>

              <div class="field">
                <label for="memberCommittee">Committee</label>
                <input id="memberCommittee" type="text" placeholder="UNSC">
              </div>

              <div class="field">
                <label for="memberPhoto">Photo index</label>
                <input id="memberPhoto" type="number" min="1" placeholder="1">
              </div>

              <div class="field">
                <label for="memberPhotoUrl">Photo URL</label>
                <input id="memberPhotoUrl" type="url" placeholder="https://...">
              </div>

              <div class="field">
                <label for="memberSort">Sort order</label>
                <input id="memberSort" type="number" value="0">
              </div>

              <div class="span-2">
                <div class="admin-actions">
                  <button class="btn btn-primary btn-sm" type="submit" id="memberSubmit">Add member</button>
                  <button class="btn btn-sm" type="button" id="memberCancel" hidden>Cancel</button>
                </div>
              </div>
            </form>

            <div class="auth-message" id="adminMessage"></div>
          </section>

          <section class="admin-panel reveal">
            <h3>Public roster</h3>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr><th>Name</th><th>Title</th><th>Committee</th><th>Order</th><th>Actions</th></tr>
                </thead>
                <tbody id="rosterBody">
                  <tr><td colspan="5"><span class="loader"></span>Loading roster...</td></tr>
                </tbody>
              </table>
            </div>
          </section>
        </div>
      </div>
    </section>
  `);

  const form = $("#memberForm");
  const formTitle = $("#formTitle");
  const submit = $("#memberSubmit");
  const cancel = $("#memberCancel");
  const message = $("#adminMessage");
  const rosterBody = $("#rosterBody");

  function resetForm(){
    form.reset();
    $("#memberId").value = "";
    $("#memberSort").value = "0";
    formTitle.textContent = "Add a secretariat member";
    submit.textContent = "Add member";
    cancel.hidden = true;
  }

  async function loadRoster(){
    const {data,error} = await supabase
      .from("members")
      .select(`id,name,role_title,committee,photo_index,photo_url,sort_order`)
      .order("sort_order",{ascending:true});

    if(error){
      rosterBody.innerHTML = `<tr><td colspan="5">Unable to load roster.</td></tr>`;
      console.error(error);
      return;
    }

    if(!data?.length){
      rosterBody.innerHTML = `<tr><td colspan="5">No members have been added.</td></tr>`;
      return;
    }

    rosterBody.innerHTML = data.map(member=>`
      <tr>
        <td>${escapeHtml(member.name)}</td>
        <td>${escapeHtml(member.role_title || "")}</td>
        <td>${escapeHtml(member.committee || "—")}</td>
        <td>${escapeHtml(member.sort_order ?? 0)}</td>
        <td>
          <div class="row-actions">
            <button type="button" class="btn btn-sm" data-edit="${member.id}">Edit</button>
            <button type="button" class="btn btn-sm" data-delete="${member.id}">Delete</button>
          </div>
        </td>
      </tr>
    `).join("");

    rosterBody.querySelectorAll("[data-edit]").forEach(button=>{
      button.addEventListener("click",()=>{
        const member = data.find(item=>String(item.id) === button.dataset.edit);
        if(!member) return;

        $("#memberId").value = member.id;
        $("#memberName").value = member.name || "";
        $("#memberRole").value = member.role_title || "";
        $("#memberCommittee").value = member.committee || "";
        $("#memberPhoto").value = member.photo_index || "";
        $("#memberPhotoUrl").value = member.photo_url || "";
        $("#memberSort").value = member.sort_order ?? 0;

        formTitle.textContent = "Edit secretariat member";
        submit.textContent = "Save changes";
        cancel.hidden = false;

        form.scrollIntoView({ behavior:"smooth", block:"center" });
      });
    });

    rosterBody.querySelectorAll("[data-delete]").forEach(button=>{
      button.addEventListener("click",async()=>{
        if(!confirm("Remove this member from the public roster?")) return;

        const {error} = await supabase.from("members").delete().eq("id",button.dataset.delete);

        if(error){
          setMessage(message,error.message,"error");
          return;
        }

        await loadRoster();
      });
    });
  }

  cancel.addEventListener("click",resetForm);

  form.addEventListener("submit",async event=>{
    event.preventDefault();
    submit.disabled = true;

    const id = $("#memberId").value.trim();

    const payload = {
      name:$("#memberName").value.trim(),
      role_title:$("#memberRole").value.trim(),
      committee:$("#memberCommittee").value.trim() || null,
      photo_index:$("#memberPhoto").value ? Number($("#memberPhoto").value) : null,
      photo_url:$("#memberPhotoUrl").value.trim() || null,
      sort_order:Number($("#memberSort").value || 0)
    };

    try{
      let response;
      if(id){
        response = await supabase.from("members").update(payload).eq("id",id);
      }else{
        response = await supabase.from("members").insert(payload);
      }

      if(response.error) throw response.error;

      setMessage(message,id ? "Member updated successfully." : "Member added successfully.","ok");

      resetForm();
      await loadRoster();
    }catch(error){
      console.error(error);
      setMessage(message,error?.message || "Unable to save member.","error");
    }finally{
      submit.disabled = false;
      submit.textContent = $("#memberId").value ? "Save changes" : "Add member";
    }
  });

  await loadRoster();
}

supabase.auth.onAuthStateChange(async(_event,session)=>{
  state.session = session;
  state.profile = session ? await loadProfile(session.user.id) : null;
  updateNav();

  if(session && currentPath() === "/login"){
    location.hash = state.profile?.role === "admin" ? "#/admin" : "#/dashboard";
    return;
  }

  if(!session && (currentPath() === "/dashboard" || currentPath() === "/admin")){
    location.hash = "#/login";
    return;
  }
});

$("#mobileToggle")?.addEventListener("click",()=>{
  const menu = $("#navMenu");
  const open = menu.classList.toggle("open");
  $("#mobileToggle").setAttribute("aria-expanded",String(open));
});

document.addEventListener("click",event=>{
  if(event.target.closest(".nav-link")){
    closeMobileMenu();
    return;
  }
  const menu = $("#navMenu");
  if(menu?.classList.contains("open") && !event.target.closest(".nav-menu") && !event.target.closest(".mobile-toggle")){
    closeMobileMenu();
  }
});

document.addEventListener("keydown",event=>{
  if(event.key === "Escape") closeMobileMenu();
});

let scrollTicking = false;
window.addEventListener("scroll",()=>{
  if(scrollTicking) return;
  scrollTicking = true;
  requestAnimationFrame(()=>{
    $("#siteNav")?.classList.toggle("scrolled",window.scrollY > 18);
    scrollTicking = false;
  });
},{passive:true});

window.addEventListener("hashchange",()=>{
  closeMobileMenu();
  router();
});

$("#year").textContent = new Date().getFullYear();

(async()=>{
  try{
    initCountdown();

    const { data:{ session } } = await supabase.auth.getSession();
    state.session = session;
    state.profile = session ? await loadProfile(session.user.id) : null;

    await router();
  }catch(error){
    console.error("Application startup error:",error);
    $("#app").innerHTML = `
      <section class="auth-screen">
        <div class="container">
          <div class="auth-card">
            <span class="eyebrow">System</span>
            <h1 class="auth-title">Something went wrong.</h1>
            <p class="auth-sub">The application could not initialize correctly. Open the browser console for more information.</p>
          </div>
        </div>
      </section>
    `;
  }
})();
</script>

