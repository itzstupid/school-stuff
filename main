const $ = selector => document.querySelector(selector);

function escapeHtml(value){
  return String(value ?? "").replace(/[&<>"']/g,char=>({
    "&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"
  }[char]));
}

function initials(name){
  return String(name || "?").trim().split(/\s+/).slice(0,2)
    .map(word=>word[0]?.toUpperCase() || "").join("");
}

function currentPath(){
  const path = location.hash.replace(/^#/,"");
  return path || "/";
}

function setMessage(element,text,type){
  element.textContent = text;
  element.className = "auth-message show " + (type || "");
}

const revealObserver = ("IntersectionObserver" in window)
  ? new IntersectionObserver(entries=>{
      entries.forEach(entry=>{
        if(entry.isIntersecting){
          entry.target.classList.add("in");
          revealObserver.unobserve(entry.target);
        }
      });
    },{ threshold:.08, rootMargin:"0px 0px -40px 0px" })
  : null;

let firstRender = true;

function renderPage(html){
  $("#app").innerHTML = html;

  const path = currentPath();

  if(path === "/"){
    if(!firstRender){
      window.scrollTo({ top:0, behavior:"smooth" });
    }
  }else{
    $("#app").scrollIntoView({ behavior: firstRender ? "instant" : "smooth", block:"start" });
  }

  firstRender = false;
  observeReveals();
  updateNav();
}

function observeReveals(){
  const elements = document.querySelectorAll(".reveal");
  if(!revealObserver){
    elements.forEach(element=>element.classList.add("in"));
    return;
  }
  elements.forEach(element=>revealObserver.observe(element));
}

function closeMobileMenu(){
  $("#navMenu")?.classList.remove("open");
  $("#mobileToggle")?.setAttribute("aria-expanded","false");
}

function updateNav(){
  const area = $("#navAuthArea");
  if(!area) return;

  if(state.session){
    const destination = state.profile?.role === "admin" ? "#/admin" : "#/dashboard";
    area.innerHTML = `
      <a href="${destination}" class="btn btn-sm btn-ghost">Portal</a>
      <button type="button" class="btn btn-sm" id="signOutButton">Sign out</button>
    `;
    $("#signOutButton")?.addEventListener("click",async()=>{
      await supabase.auth.signOut();
      state.session = null;
      state.profile = null;
      location.hash = "#/";
      updateNav();
    });
  }else{
    area.innerHTML = `
      <a href="#/register" class="btn btn-sm btn-primary">Register</a>
      <a href="#/login" class="btn btn-sm">Delegate portal</a>
    `;
  }
}

async function router(){
  const path = currentPath();
  const render = routes[path] || routes["/"];

  if((path === "/dashboard" || path === "/admin") && !state.session){
    location.hash = "#/login";
    return;
  }

  if(path === "/admin" && state.profile?.role !== "admin"){
    location.hash = "#/dashboard";
    return;
  }

  if(path === "/login" && state.session){
    location.hash = state.profile?.role === "admin" ? "#/admin" : "#/dashboard";
    return;
  }

  await render();
  updateNav();
}

const CONFERENCE_DATE = new Date("2026-10-31T00:00:00");
let countdownInterval = null;

function pad(value){
  return String(value).padStart(2,"0");
}

function initCountdown(){
  const days = $("#cdDays");
  const hours = $("#cdHours");
  const minutes = $("#cdMinutes");
  const seconds = $("#cdSeconds");
  const title = $("#splashTitleText");
  if(!days) return;

  function tick(){
    const now = new Date();
    const diff = CONFERENCE_DATE - now;

    if(diff <= 0){
      days.textContent = "00";
      hours.textContent = "00";
      minutes.textContent = "00";
      seconds.textContent = "00";
      if(title) title.textContent = "PaceMUN is here";
      clearInterval(countdownInterval);
      return;
    }

    days.textContent = pad(Math.floor(diff / 86400000));
    hours.textContent = pad(Math.floor((diff / 3600000) % 24));
    minutes.textContent = pad(Math.floor((diff / 60000) % 60));
    seconds.textContent = pad(Math.floor((diff / 1000) % 60));
  }

  tick();
  clearInterval(countdownInterval);
  countdownInterval = setInterval(tick,1000);
}

$("#splashScrollBtn")?.addEventListener("click",()=>{
  $("#app")?.scrollIntoView({ behavior:"smooth" });
});

